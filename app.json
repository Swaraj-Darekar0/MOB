{
  "expo": {
    "name": "MOB",
    "slug": "MOB",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mob",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060606",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#060606",
      "dark": {
        "backgroundColor": "#060606"
      }
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "backgroundColor": "#060606",
      "splash": {
        "backgroundColor": "#060606",
        "dark": {
          "backgroundColor": "#060606"
        }
      }
    },
    "android": {
      "package": "com.mob.virtualenvelope",
      "backgroundColor": "#060606",
      "splash": {
        "backgroundColor": "#060606",
        "resizeMode": "contain",
        "dark": {
          "backgroundColor": "#060606"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#060606",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "mob"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MOB to scan UPI QR codes to pay from your virtual envelopes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060606",
          "dark": {
            "backgroundColor": "#060606"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
